# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Visual Studio / Rider / IDE
.vs/
.idea/
.vsconfig
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
ExportedObj/
.consulo/
*.svd
*.tmp

# Unity crash recovery / upgrade logs
/[Aa]ssets/_Recovery/
UpgradeLog.htm

# OS files
.DS_Store
Thumbs.db

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Meta AnimatedDrawings is a separate third-party repo cloned locally per
# META_ANIMATED_DRAWINGS_INTEGRATION.md (its torchserve/model-store/*.mar weights
# are 300MB+ each, well over GitHub's per-file limit, and the rest is upstream
# code we don't own). Excluded wholesale; our own customizations to specific
# files within it are tracked anyway via `git add -f` (gitignore can't cleanly
# re-include individual files this many directory levels deep).
Tools/*
# ...except our own tools that live next to it
!Tools/MotionBaker/

# Desktop chat/context log — not part of this project
/chat.json

# Generated per-character animation clips: multi-MB each and regeneratable via
# "Upload and Animate with Meta..." (needs the local TorchServe container running).
# The rest of a character's StreamingAssets output (texture, mask, config) stays
# tracked since it's small and useful for inspection without re-running the pipeline.
# (the .meta needs its own line — the blanket "!/Assets/**/*.meta" negation above
# would otherwise re-include it even though the video.mp4 itself is ignored)
Assets/StreamingAssets/AnimatedDrawings/**/*.mp4
Assets/StreamingAssets/AnimatedDrawings/**/*.mp4.meta

# Headless test build output and rendered inspection images/frames
Tests/LogicTests/[Bb]in/
Tests/Output/
# the standalone logic test project is hand-written, unlike Unity's generated .csproj files
!Tests/LogicTests/LogicTests.csproj
Tests/**/[Bb]in/
!Tests/UnityCompileCheck/UnityCompileCheck.csproj
!Tests/UnityCompileCheck/EditorCheck/EditorCheck.csproj
